; ITACHI HAL domain - STARTER. Iterate with tools/avc2cil.py until `logcat | grep avc.*itachi` is empty.
; (c) @yooitachiijod
(type itachi_hal)
(type itachi_hal_exec)
(type itachi_hal_service)
(roletype object_r itachi_hal)
(roletype object_r itachi_hal_exec)
(typeattributeset domain (itachi_hal))
(typeattributeset file_type (itachi_hal_exec))
(typeattributeset vendor_file_type (itachi_hal_exec))
(typeattributeset exec_type (itachi_hal_exec))
(typeattributeset service_manager_type (itachi_hal_service))
(typeattributeset hal_service_type (itachi_hal_service))
; init starts the daemon in its own domain
(typetransition init vendor_file_exec itachi_hal process)
(allow init itachi_hal_exec (file (read open getattr execute map)))
(allow init itachi_hal (process (transition)))
(allow itachi_hal itachi_hal_exec (file (read open getattr execute map entrypoint)))
; binder + service manager (register the two AIDL HALs)
(allow itachi_hal hwservicemanager (binder (call transfer)))
(allow itachi_hal servicemanager (binder (call transfer)))
(allow itachi_hal vndservicemanager (binder (call transfer)))
(allow itachi_hal itachi_hal_service (service_manager (add find)))
(allow itachi_hal servicemanager (service_manager (list)))
(allow system_server itachi_hal_service (service_manager (find)))
(allow system_server itachi_hal (binder (call transfer)))
(allow itachi_hal system_server (binder (transfer)))
; log + sysfs (nodes get exact types from avc2cil output)
(allow itachi_hal logd (unix_stream_socket (connectto)))
